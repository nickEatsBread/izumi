[Desktop Entry]
Type=Application
Name=Install izumi
GenericName=Anime Client Installer
Comment=Install izumi and optionally add it to your Steam library
# Terminal=true makes Plasma open Konsole, so the Flatpak download reports progress instead of
# looking frozen for several minutes. The script is fetched at run time, which means a packaging
# fix reaches everyone who downloaded this file without them downloading it again.
# Piped into bash, which makes the script itself bash's stdin — install.sh therefore runs every
# child with </dev/null, or a child reading stdin would swallow the part bash has not parsed yet
# and the run would end early with no error. The alternative, staging it through a temp file, needs
# `$` and nested quotes that the Desktop Entry escaping rules make genuinely fragile.
# Double quotes, not single: the Desktop Entry spec only recognises double quotes for grouping an
# argument, so a single-quoted form is one shell dialect's luck rather than a portable launcher.
Exec=sh -c "curl -fsSL https://flatpak.izumi.watch/install.sh | bash"
Icon=utilities-terminal
Terminal=true
Categories=System;
Keywords=izumi;anime;install;steam;deck;
