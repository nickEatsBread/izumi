# Android SDK components every Android job installs. ci.yml, pr-build.yml and release.yml load
# this file into $GITHUB_ENV right after checkout, so each pin has exactly one home.
#
# NDK_VERSION follows `v_ndk` in the pinned libmpv-android checkout (scripts/ci/libmpv-android.sh):
# the libmpv AAR is built with that NDK, and r28+ emits 16 KiB-aligned ELF LOAD segments by
# default, which the app's own native code must match. scripts/ci/sync-upstream-pins.mjs keeps
# it in step when Renovate moves the commit; do not edit it by hand.
NDK_VERSION=29.0.14206865
BUILD_TOOLS=36.0.0
