+// Modified for izumi: see `try_steal_critical`.
+const CRITICAL_STEAL_FACTOR: f64 = 1.5;
+const CRITICAL_STEAL_MIN: Duration = Duration::from_millis(500);
+
 /// Tracks a piece currently being downloaded.
