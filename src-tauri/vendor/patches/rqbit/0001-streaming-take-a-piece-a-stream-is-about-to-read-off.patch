+    // Modified for izumi: take over a piece that an open stream is about to read.
+    //
+    // The ordinary steal waits until a piece has been in flight for ten times the thief's average
+    // piece time, and a player blocked on that piece stalls for the whole wait. A piece in
+    // `critical` moves once it has been in flight for 1.5 times the thief's average, and never
+    // sooner than CRITICAL_STEAL_MIN. A peer that has not completed a piece has no average and takes
+    // nothing.
+    pub fn try_steal_critical<P, S>(
+        &mut self,
+        peer: PeerHandle,
+        peer_avg_time: Option<Duration>,
+        critical: &[ValidPieceIndex],
+        peer_has_piece: P,
+        can_steal: S,
+    ) -> Option<AcquireResult>
+    where
+        P: Fn(ValidPieceIndex) -> bool,
+        S: Fn(ValidPieceIndex) -> bool,
+    {
+        let min_elapsed = peer_avg_time?
+            .mul_f64(CRITICAL_STEAL_FACTOR)
+            .max(CRITICAL_STEAL_MIN);
+        let (piece, old_peer) = critical
+            .iter()
+            .filter_map(|piece| self.inflight.get(piece).map(|info| (*piece, info)))
+            .filter(|(_, info)| info.peer != peer && info.started.elapsed() >= min_elapsed)
+            .find(|(piece, _)| peer_has_piece(*piece))
+            .map(|(piece, info)| (piece, info.peer))?;
+        if !can_steal(piece) {
+            return None;
+        }
+        let info = self.inflight.get_mut(&piece)?;
+        info.peer = peer;
+        info.started = Instant::now();
+        Some(AcquireResult::Stolen {
+            piece,
+            from_peer: old_peer,
+        })
+    }
+
     // === PIECE COMPLETION ===
 
