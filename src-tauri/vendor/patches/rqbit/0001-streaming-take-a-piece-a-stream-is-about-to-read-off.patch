+    // Added for izumi: `try_steal_critical`.
+    fn reserve(
+        tracker: &mut PieceTracker,
+        owner: PeerHandle,
+        file_infos: &FileInfos,
+        file_priorities: &FilePriorities,
+    ) -> ValidPieceIndex {
+        match tracker.acquire_piece(AcquireRequest {
+            peer: owner,
+            peer_avg_time: None,
+            priority_pieces: std::iter::empty(),
+            file_priorities,
+            file_infos,
+            peer_has_piece: |_| true,
+            can_steal: |_| true,
+        }) {
+            AcquireResult::Reserved(piece) => piece,
+            other => panic!("Expected Reserved, got {other:?}"),
+        }
+    }
+
+    fn in_flight_for(tracker: &mut PieceTracker, piece: ValidPieceIndex, elapsed: Duration) {
+        tracker.inflight.get_mut(&piece).unwrap().started =
+            Instant::now().checked_sub(elapsed).unwrap();
+    }
+
+    #[test]
+    fn a_critical_piece_moves_after_one_and_a_half_times_the_thiefs_average() {
+        let file_infos = make_test_file_infos(5);
+        let file_priorities = make_default_file_priorities(&file_infos);
+        let mut tracker = PieceTracker::new(make_test_chunk_tracker(5));
+        let piece = reserve(&mut tracker, peer(1), &file_infos, &file_priorities);
+        in_flight_for(&mut tracker, piece, Duration::from_millis(900));
+
+        match tracker.try_steal_critical(
+            peer(2),
+            Some(Duration::from_millis(400)),
+            &[piece],
+            |_| true,
+            |_| true,
+        ) {
+            Some(AcquireResult::Stolen {
+                piece: stolen,
+                from_peer,
+            }) => {
+                assert_eq!(stolen, piece);
+                assert_eq!(from_peer, peer(1));
+            }
+            other => panic!("Expected Stolen, got {other:?}"),
+        }
+        let info = tracker.get_inflight(piece).unwrap();
+        assert_eq!(info.peer, peer(2));
+        assert!(info.started.elapsed() < Duration::from_millis(900));
+    }
+
+    #[test]
+    fn a_critical_piece_stays_until_the_wait_is_over() {
+        let file_infos = make_test_file_infos(5);
+        let file_priorities = make_default_file_priorities(&file_infos);
+        let mut tracker = PieceTracker::new(make_test_chunk_tracker(5));
+        let piece = reserve(&mut tracker, peer(1), &file_infos, &file_priorities);
+
+        // 1.5 times a 100 ms average is under the 500 ms minimum.
+        in_flight_for(&mut tracker, piece, Duration::from_millis(300));
+        let fast = Some(Duration::from_millis(100));
+        assert!(
+            tracker
+                .try_steal_critical(peer(2), fast, &[piece], |_| true, |_| true)
+                .is_none()
+        );
+
+        // 1.5 times a 400 ms average is 600 ms.
+        in_flight_for(&mut tracker, piece, Duration::from_millis(500));
+        let slower = Some(Duration::from_millis(400));
+        assert!(
+            tracker
+                .try_steal_critical(peer(2), slower, &[piece], |_| true, |_| true)
+                .is_none()
+        );
+        assert_eq!(tracker.get_inflight(piece).unwrap().peer, peer(1));
+    }
+
+    #[test]
+    fn only_a_proven_peer_takes_a_critical_piece_it_can_download() {
+        let file_infos = make_test_file_infos(5);
+        let file_priorities = make_default_file_priorities(&file_infos);
+        let mut tracker = PieceTracker::new(make_test_chunk_tracker(5));
+        let critical = reserve(&mut tracker, peer(1), &file_infos, &file_priorities);
+        let other = reserve(&mut tracker, peer(1), &file_infos, &file_priorities);
+        in_flight_for(&mut tracker, critical, Duration::from_secs(5));
+        in_flight_for(&mut tracker, other, Duration::from_secs(5));
+        let average = Some(Duration::from_millis(100));
+
+        // No completed piece yet, so no average.
+        assert!(
+            tracker
+                .try_steal_critical(peer(2), None, &[critical], |_| true, |_| true)
+                .is_none()
+        );
+        // The thief does not have the piece.
+        assert!(
+            tracker
+                .try_steal_critical(peer(2), average, &[critical], |_| false, |_| true)
+                .is_none()
+        );
+        // Another peer is writing it.
+        assert!(
+            tracker
+                .try_steal_critical(peer(2), average, &[critical], |_| true, |_| false)
+                .is_none()
+        );
+        // The owner itself.
+        assert!(
+            tracker
+                .try_steal_critical(peer(1), average, &[critical], |_| true, |_| true)
+                .is_none()
+        );
+        // Not a piece a stream is waiting for: `other` keeps the ordinary 10x rule.
+        assert!(
+            tracker
+                .try_steal_critical(peer(2), average, &[], |_| true, |_| true)
+                .is_none()
+        );
+        assert_eq!(tracker.get_inflight(critical).unwrap().peer, peer(1));
+        assert_eq!(tracker.get_inflight(other).unwrap().peer, peer(1));
+    }
 }
