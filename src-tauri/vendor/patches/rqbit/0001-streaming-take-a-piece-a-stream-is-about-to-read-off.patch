+    // Added for izumi: chunks delivered before a piece completes stay marked, so a peer that
+    // takes the piece over only asks for the rest. A broken piece starts again from nothing.
+    #[test]
+    fn chunks_received_before_a_piece_completes_stay_downloaded() {
+        let piece_length = CHUNK_SIZE * 2;
+        let lengths = Lengths::new(piece_length as u64 * 2, piece_length).unwrap();
+        let bitfield = || BF::from_boxed_slice(vec![0u8; lengths.piece_bitfield_bytes()].into());
+        let mut selected = bitfield();
+        selected.set(0, true);
+        selected.set(1, true);
+        let file_infos = vec![FileInfo {
+            relative_filename: "test.dat".into(),
+            offset_in_torrent: 0,
+            len: piece_length as u64 * 2,
+            piece_range: 0..2,
+            attrs: Default::default(),
+        }];
+        let mut tracker =
+            ChunkTracker::new(bitfield().into_dyn(), selected, lengths, &file_infos).unwrap();
+        let piece = lengths.validate_piece_index(1).unwrap();
+        let chunks = lengths.iter_chunk_infos(piece).collect::<Vec<_>>();
+        let data = vec![0u8; CHUNK_SIZE as usize];
+
+        tracker.mark_chunk_downloaded(&peer_binary_protocol::Piece::from_data(
+            1, CHUNK_SIZE, &data,
+        ));
+        assert!(!tracker.is_chunk_downloaded(&chunks[0]));
+        assert!(tracker.is_chunk_downloaded(&chunks[1]));
+
+        tracker.mark_piece_broken_if_not_have(piece);
+        assert!(!tracker.is_chunk_downloaded(&chunks[1]));
+    }
