+    // Modified for izumi: whether every piece holding bytes `start..end` of file `file_id` has
+    // been downloaded and verified.
+    pub fn file_range_downloaded(&self, file_id: usize, start: u64, end: u64) -> bool {
+        let Some(metadata) = self.metadata.load_full() else {
+            return false;
+        };
+        let Some(file) = metadata.file_infos.get(file_id) else {
+            return false;
+        };
+        let end = end.min(file.len);
+        if start >= end {
+            return true;
+        }
+        let piece_length = u64::from(metadata.lengths().default_piece_length());
+        let first = (file.offset_in_torrent + start) / piece_length;
+        let last = (file.offset_in_torrent + end - 1) / piece_length;
+        self.with_chunk_tracker(|ct| {
+            let have = ct.get_have_pieces().as_slice();
+            (first..=last).all(|piece| have.get(piece as usize).is_some_and(|bit| *bit))
+        })
+        .unwrap_or(false)
+    }
+
+    // Modified for izumi: a stream that reads only what has already been downloaded. It is not
+    // registered with the torrent's streams, so it never changes which pieces are requested, and a
+    // read of a missing piece fails at once. Scrub-preview thumbnails read through one of these so
+    // they cannot compete with the video the player is waiting for.
+    pub async fn stream_passive(self: Arc<Self>, file_id: usize) -> anyhow::Result<FileStream> {
+        self.open_stream(file_id, true).await
+    }
+
+    async fn open_stream(
+        self: Arc<Self>,
+        file_id: usize,
+        passive: bool,
+    ) -> anyhow::Result<FileStream> {
         let metadata = self
             .metadata
             .load_full()
