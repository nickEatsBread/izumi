<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS code-signing entitlements for the izumi app bundle (tauri.conf.json bundle.macOS.entitlements).

  disable-library-validation: izumi loads Google's Widevine module (libwidevinecdm.dylib, from Chrome or
  Google's component service) to save protected episodes. That dylib is signed by Google's team, not
  izumi's. Under the hardened runtime, library validation admits only Apple-signed or same-team code, so
  a Developer-ID-signed, notarized izumi needs this to load it. Today's ad-hoc release has no hardened
  runtime, so validation is not enforced and this has no effect there. See docs/widevine-module-host.md.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
