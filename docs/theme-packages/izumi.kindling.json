{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 1,
  "id": "izumi.kindling",
  "name": "Kindling",
  "version": "1.1.0",
  "author": "Izumi",
  "description": "Cool gray canvas, rose accent, Nunito. Home opens on a rotating full-bleed featured banner with Watch Now and View Details, then horizontal poster rows. Continue Watching uses 16:9 episode stills. The series page keeps the banner, an overlapping cover, and a right-hand rail of episode stills.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "220 10% 10%",
      "foreground": "0 0% 98%",
      "muted": "220 10% 14%",
      "mutedForeground": "216 10% 62%",
      "primary": "0 0% 100%",
      "primaryForeground": "220 10% 10%",
      "secondary": "220 10% 16%",
      "secondaryForeground": "0 0% 98%",
      "accent": "220 10% 18%",
      "accentForeground": "0 0% 98%",
      "border": "220 8% 20%",
      "input": "220 10% 16%",
      "ring": "347 79% 51%",
      "card": "220 10% 14%",
      "cardForeground": "0 0% 98%",
      "theme": "347 79% 51%"
    },
    "radius": 0.5,
    "font": "nunito",
    "fontScale": 1,
    "backdrop": "solid",
    "backdropStrength": 0,
    "glassBlur": 0,
    "presentation": {
      "density": "comfortable",
      "trueBlack": false,
      "hideCardLabels": false,
      "shell": { "nav": "sidebar", "compact": true },
      "player": { "seekbarHeight": 4, "seekbarColor": "theme" },
      "hero": {
        "hidden": false,
        "height": 40,
        "mobileHeight": 42,
        "rotate": true,
        "interval": 15,
        "rankHidden": true,
        "template": {
          "type": "overlay",
          "style": { "minHeight": 280 },
          "children": [
            { "type": "artwork", "artwork": "backdrop", "style": { "anchor": "fill", "fit": "cover" } },
            {
              "type": "stack",
              "style": { "anchor": "bottom-start", "padding": 32, "gap": 12, "maxWidth": 720 },
              "children": [
                { "type": "text", "field": "title", "style": { "color": "#FFFFFF", "fontSize": 40, "fontWeight": 800 } },
                {
                  "type": "row",
                  "style": { "gap": 8, "align": "center" },
                  "children": [
                    { "type": "text", "field": "format", "when": { "field": "format" }, "style": { "color": "#FFFFFF", "fontSize": 14, "fontWeight": 700 } },
                    { "type": "text", "field": "episodeCount", "when": { "field": "episodeCount" }, "style": { "color": "#D0D4DC", "fontSize": 14 } },
                    { "type": "text", "field": "season", "when": { "field": "season" }, "style": { "color": "#D0D4DC", "fontSize": 14 } }
                  ]
                },
                { "type": "text", "field": "description", "when": { "field": "description" }, "style": { "color": "#D0D4DC", "fontSize": 14, "maxWidth": 640 } },
                { "type": "text", "field": "genres", "when": { "field": "genres" }, "style": { "color": "#FFFFFF", "fontSize": 13, "fontWeight": 700 } },
                {
                  "type": "row",
                  "style": { "gap": 10, "align": "center" },
                  "children": [
                    { "type": "action", "action": "play", "text": "Watch Now" },
                    { "type": "action", "action": "details", "text": "View Details", "style": { "background": "#2A3038", "color": "#FFFFFF" } }
                  ]
                }
              ]
            }
          ]
        }
      },
      "detail": {
        "layout": "split",
        "bannerHidden": false,
        "posterWidth": 230,
        "episodes": {
          "placement": "right",
          "card": {
            "type": "stack",
            "style": { "gap": 8 },
            "children": [
              {
                "type": "overlay",
                "children": [
                  { "type": "artwork", "artwork": "still", "style": { "aspect": "16 / 9", "radius": 8, "fit": "cover" } },
                  { "type": "text", "field": "duration", "when": { "field": "duration" }, "style": { "anchor": "bottom-end", "color": "#FFFFFF", "fontSize": 12, "fontWeight": 700, "padding": 8 } }
                ]
              },
              { "type": "text", "field": "title", "style": { "fontWeight": 800, "fontSize": 14 } },
              {
                "type": "row",
                "style": { "justify": "space-between", "align": "center" },
                "children": [
                  { "type": "text", "field": "episodeTitle", "when": { "field": "episodeTitle" }, "style": { "color": "muted-foreground", "fontSize": 12, "grow": 1 } },
                  { "type": "text", "field": "episodeNumber", "style": { "fontWeight": 700, "fontSize": 13 } }
                ]
              }
            ]
          }
        }
      },
      "rows": {
        "defaults": { "layout": "carousel", "width": 160, "gap": 14, "spacing": 28, "radius": 8, "titleSize": 18, "aspect": "poster" },
        "byId": { "continue": { "layout": "carousel", "width": 320, "aspect": "landscape", "radius": 8, "gap": 16 } }
      },
      "cards": {
        "poster": {
          "type": "stack",
          "style": { "gap": 8 },
          "children": [
            { "type": "artwork", "artwork": "poster", "style": { "aspect": "2 / 3", "radius": 8, "fit": "cover" } },
            { "type": "text", "field": "title", "style": { "fontWeight": 800, "fontSize": 14 } },
            {
              "type": "row",
              "style": { "justify": "space-between", "align": "center" },
              "children": [
                { "type": "text", "field": "year", "when": { "field": "year" }, "style": { "color": "muted-foreground", "fontSize": 12 } },
                { "type": "text", "field": "format", "when": { "field": "format" }, "style": { "color": "muted-foreground", "fontSize": 12 } }
              ]
            }
          ]
        },
        "continue": {
          "type": "stack",
          "style": { "gap": 8 },
          "children": [
            {
              "type": "overlay",
              "children": [
                { "type": "artwork", "artwork": "still", "style": { "aspect": "16 / 9", "radius": 8, "fit": "cover" } },
                { "type": "text", "field": "duration", "when": { "field": "duration" }, "style": { "anchor": "bottom-end", "color": "#FFFFFF", "fontSize": 12, "fontWeight": 700, "padding": 8 } }
              ]
            },
            { "type": "text", "field": "title", "style": { "fontWeight": 800, "fontSize": 14 } },
            {
              "type": "row",
              "style": { "justify": "space-between" },
              "children": [
                { "type": "text", "field": "episodeTitle", "when": { "field": "episodeTitle" }, "style": { "color": "muted-foreground", "fontSize": 12, "grow": 1 } },
                { "type": "text", "field": "episodeNumber", "style": { "fontWeight": 700, "fontSize": 13 } }
              ]
            }
          ]
        }
      }
    }
  }
}
