{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 1,
  "id": "izumi.kindling",
  "name": "Kindling",
  "version": "1.4.0",
  "author": "Izumi",
  "description": "Cool gray canvas, rose accent, Nunito. Home opens on a rotating full-bleed featured banner with Watch Now and View Details, then horizontal poster rows. The series page uses icon facts, an overlapping cover, and a right-hand rail with one short episode tile per row — square still on the left, title and synopsis on the right, grow-on-hover.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "220 10% 10%",
      "foreground": "0 0% 98%",
      "muted": "220 10% 14%",
      "mutedForeground": "216 10% 62%",
      "primary": "0 0% 100%",
      "primaryForeground": "220 10% 10%",
      "secondary": "220 10% 16%",
      "secondaryForeground": "0 0% 98%",
      "accent": "220 10% 18%",
      "accentForeground": "0 0% 98%",
      "border": "220 8% 20%",
      "input": "220 10% 16%",
      "ring": "347 79% 51%",
      "card": "220 10% 14%",
      "cardForeground": "0 0% 98%",
      "theme": "347 79% 51%"
    },
    "radius": 0.5,
    "font": "nunito",
    "fontScale": 1,
    "backdrop": "solid",
    "backdropStrength": 0,
    "glassBlur": 0,
    "presentation": {
      "density": "comfortable",
      "trueBlack": false,
      "hideCardLabels": false,
      "shell": { "nav": "sidebar", "compact": false, "press": "sink", "overlay": "fade" },
      "player": { "seekbarHeight": 4, "seekbarColor": "theme" },
      "hero": {
        "hidden": false,
        "height": 40,
        "mobileHeight": 42,
        "scale": "banner",
        "rotate": true,
        "interval": 15,
        "rankHidden": true,
        "template": {
          "type": "overlay",
          "children": [
            { "type": "artwork", "artwork": "backdrop", "style": { "anchor": "fill", "fit": "cover" } },
            {
              "type": "stack",
              "style": { "anchor": "bottom-start", "padding": 28, "gap": 10, "maxWidth": 720 },
              "children": [
                { "type": "text", "field": "title", "style": { "color": "#FFFFFF", "fontSize": 34, "fontWeight": 800 } },
                {
                  "type": "row",
                  "style": { "gap": 6, "align": "center", "wrap": "nowrap" },
                  "children": [
                    { "type": "text", "field": "format", "when": { "field": "format" }, "style": { "color": "#FFFFFF", "fontSize": 14, "fontWeight": 700 } },
                    { "type": "text", "text": "•", "style": { "color": "#8B919A", "fontSize": 10 } },
                    { "type": "text", "field": "episodeCount", "when": { "field": "episodeCount" }, "style": { "color": "#FFFFFF", "fontSize": 14 } },
                    { "type": "text", "text": "Episodes", "when": { "field": "episodeCount" }, "style": { "color": "#FFFFFF", "fontSize": 14 } },
                    { "type": "text", "text": "•", "style": { "color": "#8B919A", "fontSize": 10 } },
                    { "type": "text", "field": "season", "when": { "field": "season" }, "style": { "color": "#FFFFFF", "fontSize": 14 } }
                  ]
                },
                { "type": "text", "field": "description", "when": { "field": "description" }, "style": { "color": "#C5CAD3", "fontSize": 14, "maxWidth": 600, "lines": 4 } },
                { "type": "text", "field": "genres", "when": { "field": "genres" }, "style": { "color": "#FFFFFF", "fontSize": 13, "fontWeight": 700 } },
                {
                  "type": "row",
                  "style": { "gap": 10, "align": "center" },
                  "children": [
                    { "type": "action", "action": "play", "text": "Watch Now", "style": { "background": "#2A3038", "color": "#FFFFFF", "minHeight": 36 } },
                    { "type": "action", "action": "details", "text": "View Details", "style": { "background": "#2A3038", "color": "#FFFFFF", "minHeight": 36 } }
                  ]
                }
              ]
            }
          ]
        }
      },
      "detail": {
        "layout": "split",
        "bannerHidden": false,
        "posterWidth": 230,
        "bannerHeight": 28,
        "bannerScale": "banner",
        "actionsFirst": true,
        "coverAlign": "start",
        "facts": {
          "type": "stack",
          "style": { "gap": 12 },
          "children": [
            {
              "type": "row",
              "style": { "gap": 16, "align": "center" },
              "children": [
                { "type": "row", "when": { "field": "score" }, "style": { "gap": 8, "align": "center" }, "children": [
                  { "type": "icon", "icon": "score", "style": { "fontSize": 22 } },
                  { "type": "text", "text": "Rating:", "style": { "fontWeight": 700, "fontSize": 13 } },
                  { "type": "text", "field": "score", "style": { "fontWeight": 700, "fontSize": 13 } }
                ]},
                { "type": "row", "when": { "field": "format" }, "style": { "gap": 8, "align": "center" }, "children": [
                  { "type": "icon", "icon": "format", "style": { "fontSize": 22 } },
                  { "type": "text", "text": "Format:", "style": { "fontWeight": 700, "fontSize": 13 } },
                  { "type": "text", "field": "format", "style": { "fontWeight": 700, "fontSize": 13 } }
                ]},
                { "type": "row", "when": { "field": "episodeCount" }, "style": { "gap": 8, "align": "center" }, "children": [
                  { "type": "icon", "icon": "episodes", "style": { "fontSize": 22 } },
                  { "type": "text", "text": "Episodes:", "style": { "fontWeight": 700, "fontSize": 13 } },
                  { "type": "text", "field": "episodeCount", "style": { "fontWeight": 700, "fontSize": 13 } }
                ]},
                { "type": "row", "when": { "field": "members" }, "style": { "gap": 8, "align": "center" }, "children": [
                  { "type": "icon", "icon": "reviews", "style": { "fontSize": 22 } },
                  { "type": "text", "text": "Members:", "style": { "fontWeight": 700, "fontSize": 13 } },
                  { "type": "text", "field": "members", "style": { "fontWeight": 700, "fontSize": 13 } }
                ]}
              ]
            },
            {
              "type": "row",
              "style": { "gap": 16, "padding": 8, "background": "muted", "radius": 8, "align": "center", "wrap": "nowrap" },
              "children": [
                { "type": "row", "when": { "field": "season" }, "style": { "gap": 6, "align": "center" }, "children": [
                  { "type": "icon", "icon": "season" },
                  { "type": "text", "field": "season", "style": { "fontWeight": 700, "fontSize": 13 } }
                ]},
                { "type": "row", "when": { "field": "status" }, "style": { "gap": 6, "align": "center" }, "children": [
                  { "type": "icon", "icon": "status" },
                  { "type": "text", "field": "status", "style": { "fontWeight": 700, "fontSize": 13 } }
                ]},
                { "type": "row", "when": { "field": "studio" }, "style": { "gap": 6, "align": "center" }, "children": [
                  { "type": "icon", "icon": "studio" },
                  { "type": "text", "field": "studio", "style": { "fontWeight": 700, "fontSize": 13 } }
                ]},
                { "type": "row", "when": { "field": "source" }, "style": { "gap": 6, "align": "center" }, "children": [
                  { "type": "icon", "icon": "source" },
                  { "type": "text", "field": "source", "style": { "fontWeight": 700, "fontSize": 13 } }
                ]},
                { "type": "row", "when": { "field": "country" }, "style": { "gap": 6, "align": "center" }, "children": [
                  { "type": "icon", "icon": "country" },
                  { "type": "text", "field": "country", "style": { "fontWeight": 700, "fontSize": 13 } }
                ]}
              ]
            }
          ]
        },
        "episodes": {
          "placement": "right",
          "arrangement": "list",
          "hover": "scale",
          "order": "flip",
          "search": false,
          "card": {
            "type": "row",
            "style": { "wrap": "nowrap", "align": "stretch", "gap": 0 },
            "children": [
              { "type": "artwork", "artwork": "still", "style": { "width": 46, "aspect": "16 / 9", "fit": "cover", "shrink": 0 } },
              {
                "type": "stack",
                "style": { "grow": 1, "padding": 12, "gap": 8, "justify": "space-between" },
                "children": [
                  {
                    "type": "stack",
                    "style": { "gap": 8 },
                    "children": [
                      {
                        "type": "row",
                        "style": { "justify": "space-between", "align": "start", "wrap": "nowrap", "gap": 8 },
                        "children": [
                          { "type": "text", "field": "episodeTitle", "style": { "fontWeight": 700, "fontSize": 16, "grow": 1, "lines": 1 } },
                          { "type": "text", "field": "duration", "when": { "field": "duration" }, "style": { "fontSize": 13, "fontWeight": 700, "shrink": 0, "color": "muted-foreground" } }
                        ]
                      },
                      { "type": "meter", "field": "progress", "when": { "field": "progress", "atMost": 100 }, "style": { "minHeight": 3 } },
                      { "type": "text", "field": "description", "when": { "field": "description" }, "style": { "color": "muted-foreground", "fontSize": 12, "lines": 3 } }
                    ]
                  },
                  { "type": "text", "field": "airDate", "when": { "field": "airDate" }, "style": { "color": "muted-foreground", "fontSize": 12 } }
                ]
              }
            ]
          }
        }
      },
      "rows": {
        "defaults": { "layout": "carousel", "width": 168, "gap": 24, "spacing": 32, "radius": 8, "titleSize": 20, "aspect": "poster" },
        "byId": { "continue": { "layout": "carousel", "width": 320, "aspect": "landscape", "radius": 8, "gap": 16 } }
      },
      "cards": {
        "poster": {
          "type": "stack",
          "style": { "gap": 8 },
          "children": [
            { "type": "artwork", "artwork": "poster", "style": { "aspect": "2 / 3", "radius": 8, "fit": "cover" } },
            { "type": "text", "field": "title", "style": { "fontWeight": 800, "fontSize": 14, "lines": 2 } },
            {
              "type": "row",
              "style": { "justify": "space-between", "align": "center" },
              "children": [
                { "type": "row", "when": { "field": "year" }, "style": { "gap": 4, "align": "center" }, "children": [
                  { "type": "icon", "icon": "season", "style": { "fontSize": 14, "color": "muted-foreground" } },
                  { "type": "text", "field": "year", "style": { "color": "muted-foreground", "fontSize": 12 } }
                ]},
                { "type": "row", "when": { "field": "format" }, "style": { "gap": 4, "align": "center" }, "children": [
                  { "type": "text", "field": "format", "style": { "color": "muted-foreground", "fontSize": 12 } },
                  { "type": "icon", "icon": "format", "style": { "fontSize": 14, "color": "muted-foreground" } }
                ]}
              ]
            }
          ]
        },
        "continue": {
          "type": "stack",
          "style": { "gap": 8 },
          "children": [
            {
              "type": "overlay",
              "children": [
                { "type": "artwork", "artwork": "still", "style": { "aspect": "16 / 9", "radius": 8, "fit": "cover" } },
                { "type": "text", "field": "duration", "when": { "field": "duration" }, "style": { "anchor": "bottom-end", "color": "#FFFFFF", "fontSize": 12, "fontWeight": 700, "padding": 8 } },
                { "type": "meter", "field": "progress", "when": { "field": "progress" }, "style": { "anchor": "bottom-start", "minHeight": 4, "background": "muted" } }
              ]
            },
            { "type": "text", "field": "title", "style": { "fontWeight": 800, "fontSize": 14 } },
            {
              "type": "row",
              "style": { "justify": "space-between" },
              "children": [
                { "type": "text", "field": "episodeTitle", "when": { "field": "episodeTitle" }, "style": { "color": "muted-foreground", "fontSize": 12, "grow": 1 } },
                { "type": "text", "field": "episodeNumber", "style": { "fontWeight": 700, "fontSize": 13 } }
              ]
            }
          ]
        },
        "search": {
          "type": "stack",
          "style": { "gap": 8 },
          "children": [
            { "type": "artwork", "artwork": "poster", "style": { "aspect": "2 / 3", "radius": 8, "fit": "cover" } },
            { "type": "text", "field": "title", "style": { "fontWeight": 800, "fontSize": 14, "lines": 2 } }
          ]
        }
      }
    }
  }
}
