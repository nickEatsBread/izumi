{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 1,
  "id": "izumi.ledger",
  "name": "Ledger",
  "version": "1.3.0",
  "author": "Izumi",
  "description": "Near-black media-server look with a violet accent. Home uses a continue-watching banner, large 16:9 resume stills, then poster carousels beside an icon sidebar. The series page is a tall fluid banner, overlapping cover on the left, metadata, and a grid of episode stills below.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "0 0% 3%",
      "foreground": "0 0% 90%",
      "muted": "0 0% 8%",
      "mutedForeground": "0 0% 58%",
      "primary": "247 69% 60%",
      "primaryForeground": "0 0% 100%",
      "secondary": "0 0% 9%",
      "secondaryForeground": "0 0% 92%",
      "accent": "0 0% 12%",
      "accentForeground": "0 0% 92%",
      "border": "0 0% 16%",
      "input": "0 0% 10%",
      "ring": "247 69% 60%",
      "card": "0 0% 6%",
      "cardForeground": "0 0% 92%",
      "theme": "247 69% 60%"
    },
    "radius": 0.5,
    "font": "system",
    "fontScale": 1,
    "backdrop": "solid",
    "backdropStrength": 0,
    "glassBlur": 0,
    "presentation": {
      "density": "comfortable",
      "trueBlack": false,
      "hideCardLabels": false,
      "shell": { "nav": "sidebar", "compact": true },
      "player": { "seekbarHeight": 3, "seekbarColor": "foreground" },
      "hero": {
        "hidden": false,
        "height": 46,
        "mobileHeight": 40,
        "rotate": true,
        "interval": 8,
        "rankHidden": true,
        "template": {
          "type": "overlay",
          "children": [
            { "type": "artwork", "artwork": "backdrop", "style": { "anchor": "fill", "fit": "cover" } },
            {
              "type": "row",
              "style": { "anchor": "bottom-start", "padding": 28, "gap": 24, "align": "end" },
              "children": [
                { "type": "artwork", "artwork": "poster", "style": { "maxWidth": 180, "aspect": "2 / 3", "radius": 8, "fit": "cover" } },
                {
                  "type": "stack",
                  "style": { "gap": 8, "maxWidth": 520 },
                  "children": [
                    { "type": "text", "text": "Continue watching", "style": { "color": "#C4B5FD", "fontSize": 13, "fontWeight": 700 } },
                    { "type": "text", "field": "title", "style": { "color": "#FFFFFF", "fontSize": 30, "fontWeight": 800, "lines": 2 } },
                    { "type": "text", "field": "genres", "when": { "field": "genres" }, "style": { "color": "#D1D5DB", "fontSize": 13, "fontWeight": 700 } },
                    {
                      "type": "row",
                      "style": { "gap": 12, "align": "center" },
                      "children": [
                        { "type": "icon", "icon": "score", "when": { "field": "score" }, "style": { "fontSize": 14, "color": "#C4B5FD" } },
                        { "type": "text", "field": "score", "when": { "field": "score" }, "style": { "color": "#FFFFFF", "fontSize": 14, "fontWeight": 700 } }
                      ]
                    },
                    { "type": "text", "field": "description", "when": { "field": "description" }, "style": { "color": "#C5CAD3", "fontSize": 13, "maxWidth": 480, "lines": 3 } },
                    {
                      "type": "row",
                      "style": { "gap": 10, "align": "center" },
                      "children": [
                        { "type": "action", "action": "play", "text": "Resume", "style": { "background": "#6D5AE6", "color": "#FFFFFF", "minHeight": 36, "radius": 24 } },
                        { "type": "action", "action": "details", "text": "Preview", "style": { "background": "transparent", "color": "#FFFFFF", "minHeight": 36, "radius": 24 } }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "detail": {
        "layout": "stack",
        "bannerHidden": false,
        "posterWidth": 230,
        "bannerHeight": 42,
        "cta": "large",
        "episodes": {
          "placement": "below",
          "arrangement": "list",
          "hover": "scale",
          "search": true,
          "card": {
            "type": "row",
            "style": { "gap": 16, "align": "stretch", "wrap": "nowrap" },
            "children": [
              {
                "type": "overlay",
                "style": { "width": 24, "shrink": 0 },
                "children": [
                  { "type": "artwork", "artwork": "still", "style": { "aspect": "16 / 9", "radius": 8, "fit": "cover" } },
                  { "type": "meter", "field": "progress", "when": { "field": "progress" }, "style": { "anchor": "bottom-start", "minHeight": 4 } }
                ]
              },
              {
                "type": "stack",
                "style": { "grow": 1, "gap": 6, "padding": 8, "justify": "center" },
                "children": [
                  {
                    "type": "row",
                    "style": { "gap": 8, "align": "center" },
                    "children": [
                      { "type": "text", "field": "episodeNumber", "style": { "color": "muted-foreground", "fontSize": 13, "fontWeight": 700 } },
                      { "type": "text", "field": "duration", "when": { "field": "duration" }, "style": { "color": "muted-foreground", "fontSize": 13 } }
                    ]
                  },
                  { "type": "text", "field": "episodeTitle", "style": { "fontWeight": 800, "fontSize": 16, "lines": 1 } },
                  { "type": "text", "field": "description", "when": { "field": "description" }, "style": { "color": "muted-foreground", "fontSize": 13, "lines": 2 } }
                ]
              }
            ]
          }
        }
      },
      "rows": {
        "defaults": { "layout": "carousel", "width": 168, "gap": 14, "spacing": 32, "radius": 8, "titleSize": 20, "aspect": "poster" },
        "byId": { "continue": { "layout": "carousel", "width": 320, "aspect": "landscape", "radius": 12, "gap": 16 } }
      },
      "cards": {
        "poster": {
          "type": "stack",
          "style": { "gap": 8 },
          "children": [
            { "type": "artwork", "artwork": "poster", "style": { "aspect": "2 / 3", "radius": 8, "fit": "cover" } },
            { "type": "text", "field": "title", "style": { "fontWeight": 700, "fontSize": 13 } },
            { "type": "text", "field": "year", "when": { "field": "year" }, "style": { "color": "muted-foreground", "fontSize": 12 } }
          ]
        },
        "continue": {
          "type": "stack",
          "style": { "gap": 8 },
          "children": [
            {
              "type": "overlay",
              "children": [
                { "type": "artwork", "artwork": "still", "style": { "aspect": "2 / 1", "radius": 12, "fit": "cover" } },
                { "type": "meter", "field": "progress", "when": { "field": "progress" }, "style": { "anchor": "bottom-start", "minHeight": 4 } }
              ]
            },
            { "type": "text", "field": "episodeTitle", "when": { "field": "episodeTitle" }, "style": { "fontWeight": 800, "fontSize": 15 } },
            {
              "type": "row",
              "style": { "justify": "space-between", "align": "center" },
              "children": [
                { "type": "text", "field": "episodeNumber", "style": { "color": "muted-foreground", "fontSize": 13, "fontWeight": 700 } },
                { "type": "text", "field": "duration", "when": { "field": "duration" }, "style": { "color": "muted-foreground", "fontSize": 12 } }
              ]
            },
            { "type": "text", "field": "title", "style": { "color": "muted-foreground", "fontSize": 12 } }
          ]
        }
      }
    }
  }
}
