{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 1,
  "id": "izumi.tidal",
  "name": "Tidal",
  "version": "1.5.2",
  "author": "Izumi",
  "description": "Living-room layout: a full-bleed featured backdrop with a large title, compact top navigation, and poster rows with titles and years. The series page paints Play, title, synopsis and chips directly on the artwork. Episodes sit below as wide stills.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "220 18% 5%",
      "foreground": "0 0% 98%",
      "muted": "220 14% 10%",
      "mutedForeground": "210 12% 70%",
      "primary": "0 0% 100%",
      "primaryForeground": "220 18% 8%",
      "secondary": "220 14% 12%",
      "secondaryForeground": "0 0% 98%",
      "accent": "220 14% 16%",
      "accentForeground": "0 0% 98%",
      "border": "210 12% 18%",
      "input": "210 12% 14%",
      "ring": "0 0% 100%",
      "card": "220 14% 8%",
      "cardForeground": "0 0% 98%",
      "theme": "0 0% 100%"
    },
    "radius": 0.9,
    "font": "system",
    "fontScale": 1.05,
    "backdrop": "spotlight",
    "backdropStrength": 0.18,
    "glassBlur": 12,
    "presentation": {
      "density": "large",
      "trueBlack": true,
      "hideCardLabels": false,
      "shell": { "nav": "top", "compact": false },
      "player": { "seekbarHeight": 6, "seekbarColor": "primary" },
      "hero": {
        "hidden": false,
        "height": 62,
        "mobileHeight": 48,
        "rotate": true,
        "interval": 8,
        "rankHidden": true,
        "template": {
          "type": "overlay",
          "style": { "minHeight": 400 },
          "children": [
            { "type": "artwork", "artwork": "backdrop", "style": { "anchor": "fill", "fit": "cover" } },
            {
              "type": "stack",
              "style": { "anchor": "bottom-start", "padding": 40, "gap": 12, "maxWidth": 800 },
              "children": [
                { "type": "text", "field": "title", "style": { "color": "#FFFFFF", "fontSize": 56, "fontWeight": 800 } },
                {
                  "type": "row",
                  "style": { "gap": 8, "align": "center" },
                  "children": [
                    { "type": "text", "field": "format", "when": { "field": "format" }, "style": { "color": "#FFFFFF", "fontSize": 14, "fontWeight": 700 } },
                    { "type": "text", "field": "genres", "when": { "field": "genres" }, "style": { "color": "#E8EEF6", "fontSize": 14 } },
                    { "type": "text", "field": "year", "when": { "field": "year" }, "style": { "color": "#E8EEF6", "fontSize": 14 } }
                  ]
                },
                { "type": "text", "field": "description", "when": { "field": "description" }, "style": { "color": "#D5DDE8", "fontSize": 16, "maxWidth": 640, "lines": 3 } },
                {
                  "type": "row",
                  "style": { "gap": 12, "align": "center" },
                  "children": [
                    { "type": "action", "action": "play", "text": "Play", "style": { "background": "#FFFFFF", "color": "#0B1018", "minHeight": 44, "radius": 6, "fontWeight": 800 } },
                    { "type": "action", "action": "details", "text": "More Info", "style": { "background": "#FFFFFF33", "color": "#FFFFFF", "minHeight": 44, "radius": 6, "fontWeight": 800 } }
                  ]
                }
              ]
            }
          ]
        }
      },
      "detail": {
        "layout": "overlay",
        "bannerHidden": false,
        "episodes": {
          "placement": "below",
          "arrangement": "carousel",
          "hover": "scale",
          "search": false,
          "card": {
            "type": "stack",
            "style": { "gap": 8, "padding": 10, "radius": 14 },
            "children": [
              {
                "type": "overlay",
                "children": [
                  { "type": "artwork", "artwork": "still", "style": { "aspect": "16 / 9", "radius": 12, "fit": "cover" } },
                  { "type": "meter", "field": "progress", "when": { "field": "progress" }, "style": { "anchor": "bottom-start", "minHeight": 4 } }
                ]
              },
              {
                "type": "row",
                "style": { "gap": 8, "align": "center" },
                "children": [
                  { "type": "text", "field": "episodeNumber", "style": { "fontWeight": 800, "fontSize": 13 } },
                  { "type": "text", "field": "duration", "when": { "field": "duration" }, "style": { "color": "muted-foreground", "fontSize": 12 } },
                  { "type": "text", "field": "airDate", "when": { "field": "airDate" }, "style": { "color": "muted-foreground", "fontSize": 12 } }
                ]
              },
              { "type": "text", "field": "episodeTitle", "style": { "fontWeight": 800, "fontSize": 15, "lines": 2 } },
              { "type": "text", "field": "description", "when": { "field": "description" }, "style": { "color": "muted-foreground", "fontSize": 13, "lines": 2 } }
            ]
          }
        }
      },
      "rows": {
        "defaults": { "layout": "carousel", "width": 148, "gap": 16, "spacing": 36, "radius": 12, "titleSize": 18, "aspect": "poster" },
        "byId": { "continue": { "layout": "carousel", "width": 280, "aspect": "landscape", "radius": 14 } }
      },
      "cards": {
        "poster": {
          "type": "stack",
          "style": { "gap": 8 },
          "children": [
            { "type": "artwork", "artwork": "poster", "style": { "aspect": "2 / 3", "radius": 12, "fit": "cover" } },
            { "type": "text", "field": "title", "style": { "fontWeight": 700, "fontSize": 13, "lines": 2 } },
            { "type": "text", "field": "year", "when": { "field": "year" }, "style": { "color": "muted-foreground", "fontSize": 12 } }
          ]
        },
        "continue": {
          "type": "overlay",
          "children": [
            { "type": "artwork", "artwork": "still", "style": { "aspect": "16 / 9", "radius": 14, "fit": "cover" } },
            {
              "type": "stack",
              "style": { "anchor": "bottom-start", "padding": 12, "gap": 4 },
              "children": [
                { "type": "text", "field": "title", "style": { "color": "#FFFFFF", "fontWeight": 800, "fontSize": 14 } },
                { "type": "text", "field": "episodeTitle", "when": { "field": "episodeTitle" }, "style": { "color": "#E0E0E0", "fontSize": 12 } }
              ]
            },
            { "type": "meter", "field": "progress", "when": { "field": "progress" }, "style": { "anchor": "bottom-start", "minHeight": 5 } }
          ]
        }
      }
    }
  }
}
