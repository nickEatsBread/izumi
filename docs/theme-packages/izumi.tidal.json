{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 1,
  "id": "izumi.tidal",
  "name": "Tidal",
  "version": "1.0.0",
  "author": "Izumi",
  "description": "A living-room ocean palette: near-black canvas, cool blue accent, landscape resume cards and a split series page with the episode rail on the right.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "240 7% 5.5%",
      "foreground": "0 0% 98%",
      "muted": "240 7% 11%",
      "mutedForeground": "0 0% 70%",
      "primary": "0 0% 98%",
      "primaryForeground": "240 7% 8%",
      "secondary": "210 16% 12%",
      "secondaryForeground": "0 0% 98%",
      "accent": "210 16% 16%",
      "accentForeground": "0 0% 98%",
      "border": "210 12% 18%",
      "input": "210 12% 16%",
      "ring": "217 91% 60%",
      "card": "210 16% 12%",
      "cardForeground": "0 0% 98%",
      "theme": "217 91% 60%"
    },
    "radius": 0.75,
    "font": "system",
    "fontScale": 1,
    "backdrop": "spotlight",
    "backdropStrength": 0.22,
    "glassBlur": 18,
    "presentation": {
      "density": "comfortable",
      "trueBlack": true,
      "shell": { "nav": "sidebar", "compact": false },
      "player": { "seekbarHeight": 6, "seekbarColor": "theme" },
      "hero": { "height": 52, "mobileHeight": 42, "rotate": true, "interval": 12 },
      "detail": {
        "layout": "split",
        "posterWidth": 200,
        "episodes": {
          "placement": "right",
          "card": {
            "type": "row",
            "style": { "gap": 12, "align": "center" },
            "children": [
              { "type": "artwork", "artwork": "still", "style": { "width": 42, "aspect": "16 / 9", "radius": 8, "fit": "cover" } },
              {
                "type": "stack",
                "style": { "grow": 1, "gap": 4 },
                "children": [
                  { "type": "text", "field": "episodeTitle", "style": { "fontWeight": 800, "fontSize": 14 } },
                  {
                    "type": "row",
                    "style": { "gap": 8 },
                    "children": [
                      { "type": "text", "field": "episodeNumber", "style": { "color": "muted-foreground", "fontSize": 11 } },
                      { "type": "text", "field": "duration", "when": { "field": "duration" }, "style": { "color": "muted-foreground", "fontSize": 11 } }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "rows": {
        "defaults": { "width": 160, "gap": 16, "spacing": 36, "radius": 10, "aspect": "poster" },
        "byId": { "continue": { "layout": "carousel", "width": 280, "aspect": "landscape", "radius": 12 } }
      },
      "cards": {
        "poster": {
          "type": "stack",
          "style": { "gap": 8 },
          "children": [
            {
              "type": "overlay",
              "children": [
                { "type": "artwork", "artwork": "poster", "style": { "aspect": "2 / 3", "radius": 10, "fit": "cover" } },
                { "type": "text", "field": "score", "when": { "field": "score" }, "style": { "anchor": "top-end", "background": "#000000", "color": "#FFFFFF", "padding": 4, "radius": 4, "fontSize": 11, "fontWeight": 800 } }
              ]
            },
            { "type": "text", "field": "title", "style": { "fontWeight": 800, "fontSize": 13 } }
          ]
        },
        "continue": {
          "type": "overlay",
          "children": [
            { "type": "artwork", "artwork": "still", "style": { "aspect": "16 / 9", "radius": 12, "fit": "cover" } },
            {
              "type": "stack",
              "style": { "anchor": "bottom-start", "padding": 10, "gap": 4 },
              "children": [
                { "type": "text", "field": "title", "style": { "color": "#FFFFFF", "fontWeight": 800, "fontSize": 14 } },
                { "type": "text", "field": "episodeTitle", "style": { "color": "#E0E0E0", "fontSize": 12 } }
              ]
            }
          ]
        }
      }
    }
  }
}
