{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 1,
  "id": "izumi.ember",
  "name": "Ember",
  "version": "1.0.0",
  "author": "Izumi",
  "description": "A warm crimson living-room palette: tinted cards, a red accent, landscape resume art and the same split episode rail as Tidal.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "0 7% 5.5%",
      "foreground": "0 0% 98%",
      "muted": "0 7% 11%",
      "mutedForeground": "0 0% 70%",
      "primary": "0 0% 98%",
      "primaryForeground": "0 7% 8%",
      "secondary": "0 16% 12%",
      "secondaryForeground": "0 0% 98%",
      "accent": "0 16% 16%",
      "accentForeground": "0 0% 98%",
      "border": "0 12% 18%",
      "input": "0 12% 16%",
      "ring": "0 84% 60%",
      "card": "0 16% 12%",
      "cardForeground": "0 0% 98%",
      "theme": "0 84% 60%"
    },
    "radius": 0.7,
    "font": "nunito",
    "fontScale": 1,
    "backdrop": "spotlight",
    "backdropStrength": 0.28,
    "glassBlur": 16,
    "presentation": {
      "density": "comfortable",
      "trueBlack": true,
      "shell": { "nav": "sidebar" },
      "player": { "seekbarHeight": 6, "seekbarColor": "theme" },
      "hero": { "height": 50, "mobileHeight": 44 },
      "detail": {
        "layout": "split",
        "posterWidth": 196,
        "episodes": {
          "placement": "right",
          "card": {
            "type": "row",
            "style": { "gap": 12, "align": "center" },
            "children": [
              { "type": "artwork", "artwork": "still", "style": { "width": 40, "aspect": "16 / 9", "radius": 8, "fit": "cover" } },
              {
                "type": "stack",
                "style": { "grow": 1, "gap": 4 },
                "children": [
                  { "type": "text", "field": "episodeTitle", "style": { "fontWeight": 800, "fontSize": 14 } },
                  { "type": "text", "field": "duration", "when": { "field": "duration" }, "style": { "color": "muted-foreground", "fontSize": 11 } }
                ]
              }
            ]
          }
        }
      },
      "rows": {
        "defaults": { "width": 156, "gap": 14, "spacing": 32, "radius": 10 },
        "byId": { "continue": { "layout": "carousel", "width": 276, "aspect": "landscape" } }
      },
      "cards": {
        "continue": {
          "type": "overlay",
          "children": [
            { "type": "artwork", "artwork": "still", "style": { "aspect": "16 / 9", "radius": 10, "fit": "cover" } },
            {
              "type": "stack",
              "style": { "anchor": "bottom-start", "padding": 10, "gap": 4, "background": "#000000" },
              "children": [
                { "type": "text", "field": "title", "style": { "color": "#FFFFFF", "fontWeight": 800, "fontSize": 13 } },
                { "type": "text", "field": "progress", "when": { "field": "progress" }, "style": { "color": "theme", "fontSize": 11, "fontWeight": 800 } }
              ]
            }
          ]
        }
      }
    }
  }
}
