{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 1,
  "id": "izumi.ember",
  "name": "Ember",
  "version": "1.2.0",
  "author": "Izumi",
  "description": "A warm crimson living-room palette: tinted cards, a red accent, landscape resume art and the same split episode rail as Tidal.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "0 7% 5.5%",
      "foreground": "0 0% 98%",
      "muted": "0 7% 11%",
      "mutedForeground": "0 0% 70%",
      "primary": "0 0% 98%",
      "primaryForeground": "0 7% 8%",
      "secondary": "0 16% 12%",
      "secondaryForeground": "0 0% 98%",
      "accent": "0 16% 16%",
      "accentForeground": "0 0% 98%",
      "border": "0 12% 18%",
      "input": "0 12% 16%",
      "ring": "0 84% 60%",
      "card": "0 16% 12%",
      "cardForeground": "0 0% 98%",
      "theme": "0 84% 60%"
    },
    "radius": 0.7,
    "font": "nunito",
    "fontScale": 1,
    "backdrop": "spotlight",
    "backdropStrength": 0.28,
    "glassBlur": 16,
    "presentation": {
      "density": "comfortable",
      "trueBlack": true,
      "shell": { "nav": "sidebar", "compact": false },
      "player": { "seekbarHeight": 6, "seekbarColor": "theme" },
      "hero": {
        "height": 50,
        "mobileHeight": 44,
        "rotate": true,
        "interval": 13,
        "rankHidden": true,
        "template": {
          "type": "overlay",
          "children": [
            { "type": "artwork", "artwork": "backdrop", "style": { "anchor": "fill", "fit": "cover" } },
            {
              "type": "stack",
              "style": { "anchor": "bottom-start", "padding": 32, "gap": 10, "maxWidth": 680 },
              "children": [
                { "type": "text", "field": "title", "style": { "color": "#FFFFFF", "fontSize": 40, "fontWeight": 800 } },
                { "type": "text", "field": "genres", "when": { "field": "genres" }, "style": { "color": "#F3C4C4", "fontSize": 14, "fontWeight": 700 } },
                { "type": "text", "field": "description", "when": { "field": "description" }, "style": { "color": "#E8D5D5", "fontSize": 14, "maxWidth": 560, "lines": 3 } },
                {
                  "type": "row",
                  "style": { "gap": 10 },
                  "children": [
                    { "type": "action", "action": "play", "text": "Play", "style": { "background": "#E11D48", "color": "#FFFFFF", "minHeight": 40, "radius": 24 } },
                    { "type": "action", "action": "details", "text": "Details", "style": { "background": "#FFFFFF22", "color": "#FFFFFF", "minHeight": 40, "radius": 24 } }
                  ]
                }
              ]
            }
          ]
        }
      },
      "detail": {
        "layout": "overlay",
        "bannerHidden": false,
        "cta": "large",
        "episodes": {
          "placement": "below",
          "arrangement": "grid",
          "hover": "scale",
          "search": true,
          "card": {
            "type": "stack",
            "style": { "gap": 8 },
            "children": [
              {
                "type": "overlay",
                "children": [
                  { "type": "artwork", "artwork": "still", "style": { "aspect": "16 / 9", "radius": 10, "fit": "cover" } },
                  { "type": "meter", "field": "progress", "when": { "field": "progress" }, "style": { "anchor": "bottom-start", "minHeight": 3 } }
                ]
              },
              { "type": "text", "field": "episodeTitle", "style": { "fontWeight": 800, "fontSize": 14, "lines": 1 } },
              {
                "type": "row",
                "style": { "gap": 8, "align": "center" },
                "children": [
                  { "type": "text", "field": "episodeNumber", "style": { "color": "muted-foreground", "fontSize": 12, "fontWeight": 700 } },
                  { "type": "text", "field": "duration", "when": { "field": "duration" }, "style": { "color": "muted-foreground", "fontSize": 12 } }
                ]
              }
            ]
          }
        }
      },
      "rows": {
        "defaults": { "width": 156, "gap": 14, "spacing": 32, "radius": 10 },
        "byId": { "continue": { "layout": "carousel", "width": 276, "aspect": "landscape" } }
      },
      "cards": {
        "continue": {
          "type": "overlay",
          "children": [
            { "type": "artwork", "artwork": "still", "style": { "aspect": "16 / 9", "radius": 10, "fit": "cover" } },
            {
              "type": "stack",
              "style": { "anchor": "bottom-start", "padding": 10, "gap": 4, "background": "#000000" },
              "children": [
                { "type": "text", "field": "title", "style": { "color": "#FFFFFF", "fontWeight": 800, "fontSize": 13 } },
                { "type": "text", "field": "progress", "when": { "field": "progress" }, "style": { "color": "theme", "fontSize": 11, "fontWeight": 800 } }
              ]
            },
            { "type": "meter", "field": "progress", "when": { "field": "progress" }, "style": { "anchor": "bottom-start", "minHeight": 4 } }
          ]
        },
        "poster": {
          "type": "stack",
          "style": { "gap": 8 },
          "children": [
            { "type": "artwork", "artwork": "poster", "style": { "aspect": "2 / 3", "radius": 10, "fit": "cover" } },
            { "type": "text", "field": "title", "style": { "fontWeight": 800, "fontSize": 13, "lines": 2 } },
            { "type": "text", "field": "year", "when": { "field": "year" }, "style": { "color": "muted-foreground", "fontSize": 12 } }
          ]
        },
        "search": {
          "type": "stack",
          "style": { "gap": 8 },
          "children": [
            { "type": "artwork", "artwork": "poster", "style": { "aspect": "2 / 3", "radius": 10, "fit": "cover" } },
            { "type": "text", "field": "title", "style": { "fontWeight": 800, "fontSize": 13, "lines": 1 } }
          ]
        }
      }
    }
  }
}
