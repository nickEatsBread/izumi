{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 1,
  "id": "izumi.orchid",
  "name": "Orchid",
  "version": "1.0.0",
  "author": "Izumi",
  "description": "A violet living-room palette: cool-black canvas, purple accent, landscape resume cards and a split series page. Pair with true black on OLED.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "240 7% 5.5%",
      "foreground": "0 0% 98%",
      "muted": "240 7% 11%",
      "mutedForeground": "0 0% 70%",
      "primary": "0 0% 98%",
      "primaryForeground": "270 16% 8%",
      "secondary": "270 16% 12%",
      "secondaryForeground": "0 0% 98%",
      "accent": "270 16% 16%",
      "accentForeground": "0 0% 98%",
      "border": "270 12% 20%",
      "input": "270 12% 16%",
      "ring": "258 90% 66%",
      "card": "270 16% 12%",
      "cardForeground": "0 0% 98%",
      "theme": "258 90% 66%"
    },
    "radius": 0.8,
    "font": "nunito",
    "fontScale": 1,
    "backdrop": "mesh",
    "backdropStrength": 0.3,
    "glassBlur": 20,
    "presentation": {
      "density": "comfortable",
      "trueBlack": true,
      "shell": { "nav": "sidebar" },
      "player": { "seekbarHeight": 6, "seekbarColor": "theme" },
      "hero": { "height": 54, "mobileHeight": 44, "rankHidden": false },
      "detail": {
        "layout": "split",
        "posterWidth": 204,
        "episodes": {
          "placement": "right",
          "card": {
            "type": "row",
            "style": { "gap": 12, "align": "center" },
            "children": [
              { "type": "artwork", "artwork": "still", "style": { "width": 40, "aspect": "16 / 9", "radius": 10, "fit": "cover" } },
              {
                "type": "stack",
                "style": { "grow": 1, "gap": 4 },
                "children": [
                  { "type": "text", "field": "episodeTitle", "style": { "fontWeight": 800, "fontSize": 14 } },
                  { "type": "text", "field": "airDate", "when": { "field": "airDate" }, "style": { "color": "muted-foreground", "fontSize": 11 } }
                ]
              }
            ]
          }
        }
      },
      "rows": {
        "defaults": { "width": 164, "gap": 16, "spacing": 36, "radius": 12 },
        "byId": { "continue": { "layout": "carousel", "width": 288, "aspect": "landscape" } }
      },
      "cards": {
        "poster": {
          "type": "overlay",
          "children": [
            { "type": "artwork", "artwork": "poster", "style": { "aspect": "2 / 3", "radius": 12, "fit": "cover" } },
            { "type": "text", "field": "title", "style": { "anchor": "bottom-start", "padding": 8, "color": "#FFFFFF", "fontWeight": 800, "fontSize": 13 } }
          ]
        }
      }
    }
  }
}
