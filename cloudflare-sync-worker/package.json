{
  "name": "izumi-cloudflare-sync",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "npm run db:migrations:apply && wrangler deploy",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "wrangler": "^4.33.1"
  },
  "cloudflare": {
    "bindings": {
      "BOOTSTRAP_SECRET": {
        "description": "Paste the 32-byte one-time setup secret generated by Izumi. This is not a Cloudflare API key. Keep it private."
      },
      "DB": {
        "description": "Private D1 database for encrypted Izumi sync records."
      }
    }
  }
}
