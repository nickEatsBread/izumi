# Copy to .env. These are PUBLIC OAuth client IDs (not secrets) — implicit/PKCE
# grants need no client secret. Register your apps with the redirect URI below.
PUBLIC_ANILIST_CLIENT_ID=your-anilist-client-id
PUBLIC_MAL_CLIENT_ID=your-mal-client-id
PUBLIC_SIMKL_CLIENT_ID=your-simkl-client-id
PUBLIC_OAUTH_REDIRECT_URI=https://client.izumi.watch/callback

# Public, read-only Discuss Anime application identifier. Keep the issued value in
# .env.local (ignored) or a CI secret rather than committing it here.
PUBLIC_DISCUSS_ANIME_API_KEY=your-discuss-anime-api-key

# Optional application-level TMDB read token. Open-source desktop builds normally leave this
# unset and let users enter their own token under Settings → Catalog.
PUBLIC_TMDB_READ_TOKEN=
