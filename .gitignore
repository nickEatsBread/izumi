node_modules/
build/
.svelte-kit/
dist/
src-tauri/target/
src-tauri/gen/
.DS_Store
*.log

# Local drafts stay ignored; maintained project reports remain trackable.
/docs/*
!/docs/DOLBY_PLAYBACK.md
!/docs/DOLBY_RESEARCH.md
!/docs/PLAYER_ARCHITECTURE_RESEARCH.md
!/docs/THEMES.md
!/docs/THEME_SYSTEM_AUDIT.md
!/docs/recommendation-watch-habits-research.md
!/docs/recommendation-evaluation/

/distnet/

# Updater signing keys
*.key
izumi_updater.key
.env
.env.local

# Native libmpv binaries staged into src-tauri/ at build time (bundled by CI, not committed)
src-tauri/*.dll
src-tauri/*.dylib
src-tauri/macos-frameworks/

# Subtitle font staged into the Android mpv plugin at build time (scripts/fetch-subtitle-font.mjs)
src-tauri/tauri-plugin-mpv/android/src/main/assets/fonts/

# Security-pinned libmpv AAR staged from source by scripts/ci/libmpv-android.sh
src-tauri/tauri-plugin-mpv/android/libs/libmpv.aar

# Local Flatpak bundle artifact (built + deployed, not committed)
izumi.flatpak

# Flatpak build artifacts (OSTree repo, build dir, exported signing pubkey) — CI + local
flatpak/_repo/
flatpak/_build/
flatpak/.flatpak-builder/
/.flatpak-builder/
flatpak/izumi-key.gpg
.claude/

# Local capture/probe dumps (not part of the app)
.probe/
/src-tauri/.idea

# Local build output (packaged bundles, not committed)
/output/
/artifacts/worker/
/.codex-tmp
/.superpowers/
/tmp/
/tv-installer/

# Local native probe/stub artifacts from Windows link checks and gamescope timing probes
/.probe-gm-*.exe
/.probe-gm-*.pdb
/mpv-stub.*

# Session scratch under scripts/ci/; shared CI helpers keep unprefixed names and stay tracked
scripts/ci/_*
scripts/ci/__pycache__/
